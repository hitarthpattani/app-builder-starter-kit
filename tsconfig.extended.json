{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src/commerce-backend-ui-2",
    "module": "ES2020",
    "target": "es2020",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "removeComments": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": false,
    "paths": {
      "@actions/*": ["./src/commerce-backend-ui-2/actions/*"],
      "@lib/*": ["./src/commerce-backend-ui-2/lib/*"],
      "@scripts/*": ["./src/commerce-backend-ui-2/scripts/*"]
    }
  },
  "include": [
    "src/commerce-backend-ui-2/actions/**/*",
    "src/commerce-backend-ui-2/lib/**/*",
    "src/commerce-backend-ui-2/scripts/**/*"
  ],
  "exclude": [
    "src/commerce-backend-ui-2/actions/**/*.js",
    "src/commerce-backend-ui-2/lib/**/*.js",
    "src/commerce-backend-ui-2/scripts/**/*.js",
    "node_modules",
    "build"
  ]
}

